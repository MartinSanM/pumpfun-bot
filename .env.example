# ==========================================================
# PUMP.FUN SNIPER + ML SCORER CONFIGURATION (.env TEMPLATE)
# You can input your keys in `keys.json` OR in `.env`.
# ==========================================================

RPC_HTTPS_URL=https://api.mainnet-beta.solana.com
RPC_WSS_URL=wss://api.mainnet-beta.solana.com
RPC_API_KEY=PASTE_OPTIONAL_RPC_API_KEY_HERE
PUMPPORTAL_API_KEY=PASTE_OPTIONAL_PUMPPORTAL_API_KEY_HERE
SOLANA_PRIVATE_KEY=PASTE_YOUR_BASE58_PRIVATE_KEY_HERE

BUY_AMOUNT_SOL=0.05
SLIPPAGE_BPS=1500
PRIORITY_FEE_SOL=0.0015
TAKE_PROFIT_PCT=100.0
STOP_LOSS_PCT=35.0
MAX_DEV_HOLDING_PCT=15.0
MIN_ML_WIN_PROB=0.65
AUTO_SELL_ENABLED=true
DRY_RUN=true
